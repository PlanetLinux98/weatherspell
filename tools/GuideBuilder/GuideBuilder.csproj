<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time only: turns USER_GUIDE.md into the page the exe embeds.
       Weatherspell.csproj builds and runs it; nothing from here ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets keeps Markdig from flowing into the exe project that
         references this one. -->
    <PackageReference Include="Markdig" Version="1.4.0" PrivateAssets="all" />
  </ItemGroup>

</Project>

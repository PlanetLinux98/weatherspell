<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is already part of Windows 10 (1903+) and 11, so the
         exe is the whole program: nothing to install, nothing beside it. See
         NOTES.md for what that rules out (exe.config, per-monitor DPI, runtime
         NuGet dependencies). -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Weatherspell</RootNamespace>
    <AssemblyName>Weatherspell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded as a Win32 resource, so Explorer, the taskbar and the form
         all read it from the exe; nothing ships beside it. Drawn by
         Assets\make-icon.ps1, which also writes the SVGs beside it. -->
    <ApplicationIcon>..\..\Assets\Weatherspell.ico</ApplicationIcon>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The shipped file is the bare exe, so nothing may need
         Weatherspell.exe.config at runtime. Do not generate one: no binding
         redirects, no config-driven settings. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>

    <Product>Weatherspell</Product>
    <Authors>PlanetLinux98</Authors>
    <Company>PlanetLinux98</Company>
    <Copyright>Copyright (c) 2026 PlanetLinux98</Copyright>
    <Description>A text-based weather app for Windows.</Description>
    <NeutralLanguage>en-CA</NeutralLanguage>
    <Deterministic>true</Deterministic>

    <!-- Versioning is driven by MinVer from git tags (releases are tagged
         vX.Y.Z), so the version is never hand-edited; do not add a <Version>
         property, it would override MinVer's computed value. Untagged commits
         get the next minor as a pre-release. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <!-- Modern C# syntax on the frozen 4.8 BCL: PolySharp generates the missing
         compiler-support types (IsExternalInit, required, nullable attributes)
         at build time; nothing ships. Runtime-backed features (default
         interface members, static abstract members, ref fields) stay off. -->
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-box .NET Framework assemblies the SDK does not reference by
         default. Nothing ships: they live in the GAC on every machine. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GeoNames table behind postal code search for the countries the
         geocoder lacks, inside the exe like everything else (about half a
         megabyte of text). tools\Update-PostalCodes.ps1 regenerates it. -->
    <EmbeddedResource Include="Weather\PostalCodes.tsv" LogicalName="PostalCodes.tsv" />
    <!-- The user guide F1 opens (see UserGuide), built from USER_GUIDE.md by
         the BuildUserGuide target below. -->
    <EmbeddedResource Include="$(IntermediateOutputPath)user-guide.html" LogicalName="user-guide.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first so it can run below. No reference and no copy: Markdig
         stays with the tool (PrivateAssets there) and nothing ships. -->
    <ProjectReference Include="..\..\tools\GuideBuilder\GuideBuilder.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <UserGuideSource>$(MSBuildThisFileDirectory)..\..\USER_GUIDE.md</UserGuideSource>
    <UserGuideTemplate>$(MSBuildThisFileDirectory)..\..\tools\GuideBuilder\template.html</UserGuideTemplate>
    <GuideBuilderExe>$(MSBuildThisFileDirectory)..\..\tools\GuideBuilder\bin\$(Configuration)\net48\GuideBuilder.exe</GuideBuilderExe>
  </PropertyGroup>

  <!-- USER_GUIDE.md is the guide as GitHub shows it; this makes the same text
       the page inside the exe. -->
  <Target Name="BuildUserGuide" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources"
          Inputs="$(UserGuideSource);$(UserGuideTemplate);$(GuideBuilderExe)" Outputs="$(IntermediateOutputPath)user-guide.html">
    <Exec Command="&quot;$(GuideBuilderExe)&quot; &quot;$(UserGuideSource)&quot; &quot;$(UserGuideTemplate)&quot; &quot;$(IntermediateOutputPath)user-guide.html&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)user-guide.html" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Tests reference this exe directly; internals stay internal. So
         does the tool that writes 0.1's text for the Rust port's tests. -->
    <InternalsVisibleTo Include="Weatherspell.Tests" />
    <InternalsVisibleTo Include="ReferenceText" />
  </ItemGroup>

</Project>
